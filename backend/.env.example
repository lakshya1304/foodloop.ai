# Database connection string (using SQLite for demo)
DATABASE_URL="file:./dev.db"

# JWT Secret for authentication (change this in production)
JWT_SECRET="super-secret-key-for-foodloop-demo-123456"

# Google Gemini API Key for AI Demand Prediction and OCR Extraction
